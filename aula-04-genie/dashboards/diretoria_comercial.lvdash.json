{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (uma linha por venda)",
      "queryLines": [
        "SELECT id_venda, data_venda, data, dia_semana, dia_semana_num, hora,\n",
        "       CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' ELSE canal_venda END AS canal,\n",
        "       id_produto, nome_produto, categoria, quantidade, receita\n",
        "FROM vendas_detalhadas\n"
      ],
      "columns": [
        {
          "displayName": "receita_total",
          "description": "Receita em R$",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "vendas",
          "description": "Número de vendas",
          "expression": "COUNT(`id_venda`)"
        },
        {
          "displayName": "ticket_medio",
          "description": "Receita total / número de vendas",
          "expression": "SUM(`receita`) / COUNT(`id_venda`)"
        },
        {
          "displayName": "itens_vendidos",
          "description": "Unidades vendidas",
          "expression": "SUM(`quantidade`)"
        },
        {
          "displayName": "receita_media_dia",
          "description": "Receita / número de dias distintos",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `data`)"
        }
      ]
    },
    {
      "name": "ds_top10",
      "displayName": "Top 10 produtos por receita",
      "queryLines": [
        "SELECT id_produto, nome_produto, categoria,\n",
        "       COUNT(*) AS vendas, SUM(quantidade) AS itens_vendidos, SUM(receita) AS receita\n",
        "FROM vendas_detalhadas\n",
        "WHERE data BETWEEN :periodo.min AND :periodo.max\n",
        "  AND (:canal IS NULL OR size(:canal) = 0 OR array_contains(:canal, CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' ELSE canal_venda END))\n",
        "GROUP BY id_produto, nome_produto, categoria\n",
        "ORDER BY receita DESC, id_produto\n",
        "LIMIT 10\n"
      ],
      "parameters": [
        {
          "displayName": "periodo",
          "keyword": "periodo",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-12-13"
              },
              "max": {
                "value": "2026-01-11"
              }
            }
          }
        },
        {
          "displayName": "canal",
          "keyword": "canal",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          }
        }
      ]
    }
  ],
