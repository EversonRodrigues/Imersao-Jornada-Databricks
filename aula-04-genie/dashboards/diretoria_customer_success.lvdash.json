{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Clientes (uma linha por cliente)",
      "queryLines": [
        "SELECT id_cliente, nome_cliente, estado, nome_estado, regiao, segmento_cliente,\n",
        "       total_compras, receita, ticket_medio, ultima_compra, ranking_receita,\n",
        "       CASE WHEN segmento_cliente = 'VIP' THEN receita ELSE 0 END AS receita_vip,\n",
        "       CASE WHEN segmento_cliente = 'VIP' THEN 1 ELSE 0 END AS cliente_vip\n",
        "FROM clientes_segmentacao\n",
        "ORDER BY ranking_receita\n"
      ],
      "columns": [
        {
          "displayName": "clientes",
          "description": "Número de clientes",
          "expression": "COUNT(`id_cliente`)"
        },
        {
          "displayName": "clientes_vip",
          "description": "Clientes VIP",
          "expression": "SUM(`cliente_vip`)"
        },
        {
          "displayName": "pct_receita_vip",
          "description": "Receita dos VIP / receita total",
          "expression": "SUM(`receita_vip`) / SUM(`receita`)"
        },
        {
          "displayName": "ticket_medio",
          "description": "Receita total / total de compras",
          "expression": "SUM(`receita`) / SUM(`total_compras`)"
        },
        {
          "displayName": "receita_total",
          "description": "Receita em R$",
          "expression": "SUM(`receita`)"
        }
      ]
    }
  ],
