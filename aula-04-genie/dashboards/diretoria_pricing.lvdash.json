{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Preços vs. concorrência (uma linha por produto)",
      "queryLines": [
        "SELECT id_produto, nome_produto, categoria, marca,\n",
        "       nosso_preco, preco_medio_concorrentes, preco_minimo_concorrentes, total_concorrentes,\n",
        "       diferenca_pct_vs_media / 100 AS diferenca_vs_media,\n",
        "       diferenca_pct_vs_minimo / 100 AS diferenca_vs_minimo,\n",
        "       classificacao_preco,\n",
        "       CASE classificacao_preco WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos' WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média' WHEN 'NA_MEDIA' THEN 'Na média' WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média' WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos' ELSE classificacao_preco END AS classificacao,\n",
        "       possui_preco_suspeito,\n",
        "       CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "       CASE WHEN possui_preco_suspeito THEN 'Preço suspeito (a conferir)' ELSE 'Confirmado' END AS situacao_preco,\n",
        "       CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN 1 ELSE 0 END AS mais_caro_confirmado,\n",
        "       CASE WHEN possui_preco_suspeito THEN 1 ELSE 0 END AS suspeito,\n",
        "       receita, itens_vendidos\n",
        "FROM precos_competitividade\n",
        "ORDER BY receita DESC, id_produto\n"
      ],
      "columns": [
        {
          "displayName": "produtos",
          "description": "Produtos monitorados",
          "expression": "COUNT(`id_produto`)"
        },
        {
          "displayName": "mais_caros_confirmados",
          "description": "Mais caros que todos, sem preço suspeito",
          "expression": "SUM(`mais_caro_confirmado`)"
        },
        {
          "displayName": "receita_mais_caros_confirmados",
          "description": "Receita dos mais caros confirmados",
          "expression": "SUM(`receita` * `mais_caro_confirmado`)"
        },
        {
          "displayName": "produtos_suspeitos",
          "description": "Produtos com preço suspeito",
          "expression": "SUM(`suspeito`)"
        }
      ]
    }
  ],
  "pages": [
